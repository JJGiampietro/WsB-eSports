rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      let grant = signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ? get(/databases/$(database)/documents/admins/$(request.auth.uid)).data : null;
      return signedIn() && grant != null && grant.get('enabled', true) == true
        && (!('memberId' in grant) || (get(/databases/$(database)/documents/memberAccess/$(grant.memberId)).data.ownerUid == request.auth.uid
          && get(/databases/$(database)/documents/memberAccess/$(grant.memberId)).data.role == 'admin'
          && get(/databases/$(database)/documents/memberAccess/$(grant.memberId)).data.status == 'active'));
    }

    function ownsMember(memberId) {
      return signedIn()
        && get(/databases/$(database)/documents/memberAccess/$(memberId)).data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/memberAccess/$(memberId)).data.status == 'active';
    }

    function validMemberUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'bio', 'socials', 'profileImage', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 48
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 280
        && request.resource.data.socials is map
        && request.resource.data.socials.keys()
          .hasOnly(['tiktok', 'twitch', 'youtube', 'instagram'])
        && (!('tiktok' in request.resource.data.socials) || request.resource.data.socials.tiktok is string)
        && (!('twitch' in request.resource.data.socials) || request.resource.data.socials.twitch is string)
        && (!('youtube' in request.resource.data.socials) || request.resource.data.socials.youtube is string)
        && (!('instagram' in request.resource.data.socials) || request.resource.data.socials.instagram is string)
        && request.resource.data.profileImage is string
        && request.resource.data.profileImage.size() <= 200000
        && (request.resource.data.profileImage.size() == 0 || request.resource.data.profileImage.matches('^data:image/(webp|jpeg|png);base64,[A-Za-z0-9+/=]+$'));
    }

    match /members/{memberId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (ownsMember(memberId) && validMemberUpdate());
    }

    match /memberAccess/{memberId} {
      allow get: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow list: if isAdmin() || (signedIn() && (
        resource.data.ownerUid == request.auth.uid || (request.auth.token.get('email_verified', false) == true
          && resource.data.invitedEmail == request.auth.token.email)
      ));
      allow create: if isAdmin() && request.resource.data.role in ['member', 'creator', 'management', 'owner', 'admin'];
      allow delete: if isAdmin() && resource.data.ownerUid != request.auth.uid;
      allow update: if (isAdmin()
          && request.resource.data.role in ['member', 'creator', 'management', 'owner', 'admin']
          && (resource.data.ownerUid != request.auth.uid || resource.data.get('role', '') != 'admin'
            || (request.resource.data.role == 'admin' && request.resource.data.status == 'active' && request.resource.data.ownerUid == request.auth.uid)))
        || (signedIn()
        && resource.data.ownerUid == null
        && resource.data.status == 'invited'
        && request.auth.token.get('email_verified', false) == true
        && resource.data.invitedEmail == request.auth.token.email
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == "active" && request.resource.data.claimedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid', 'status', 'claimedAt']));
    }

    function validBounty(data) {
      return data.keys().hasAll(['targetName', 'amount', 'mode', 'instructions', 'image', 'status', 'winningClaimId', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['targetName', 'amount', 'mode', 'instructions', 'image', 'status', 'winningClaimId', 'createdBy', 'createdAt', 'updatedAt', 'expiresAt', 'eligibility', 'disputePolicy'])
        && (!('expiresAt' in data) || data.expiresAt == null || data.expiresAt is timestamp)
        && (!('eligibility' in data) || (data.eligibility is string && data.eligibility.size() <= 1000))
        && (!('disputePolicy' in data) || (data.disputePolicy is string && data.disputePolicy.size() <= 1000))
        && data.targetName is string && data.targetName.size() > 0 && data.targetName.size() <= 80
        && data.amount is int && data.amount >= 5 && data.amount <= 20
        && data.mode in ['Any mode', 'Battle Royale', 'Zero Build', 'Reload']
        && data.instructions is string && data.instructions.size() > 0 && data.instructions.size() <= 1500
        && data.image is string && data.image.size() <= 200000
        && (data.image in ['wsb-logo.png', 'elusion.png', 'mysterious.png', 'mello.png', 'kato.png']
          || data.image.matches('^data:image/(webp|jpeg|png);base64,[A-Za-z0-9+/=]+$'))
        && data.status in ['open', 'paused', 'claimed', 'archived']
        && data.winningClaimId is string && data.winningClaimId.size() <= 200
        && data.createdBy is string && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function validBountyWinner(bountyId) {
      let next = request.resource.data;
      let previous = resource.data;
      return (next.winningClaimId == previous.winningClaimId
          && (next.winningClaimId == '' ? next.status != 'claimed' : next.status in ['claimed', 'archived']))
        || (previous.winningClaimId == '' && previous.status == 'open'
          && next.status == 'claimed' && next.winningClaimId != ''
          && getAfter(/databases/$(database)/documents/bountyClaims/$(next.winningClaimId)).data.bountyId == bountyId
          && getAfter(/databases/$(database)/documents/bountyClaims/$(next.winningClaimId)).data.status == 'approved'
          && getAfter(/databases/$(database)/documents/bountyClaims/$(next.winningClaimId)).data.reviewedAt == request.time);
    }

    match /bounties/{bountyId} {
      allow read: if signedIn();
      allow create: if isAdmin() && validBounty(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.status in ['open', 'paused']
        && request.resource.data.winningClaimId == '';
      allow update: if isAdmin() && validBounty(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && validBountyWinner(bountyId);
      // Removal is an archive operation, preserving evidence and decisions.
      allow delete: if false;
    }

    function activeBountyMember(data) {
      return signedIn() && ((isAdmin() && data.memberId == '')
        || (data.memberId != ''
          && get(/databases/$(database)/documents/memberAccess/$(data.memberId)).data.ownerUid == request.auth.uid
          && get(/databases/$(database)/documents/memberAccess/$(data.memberId)).data.status == 'active'));
    }

    function validClaim(data) {
      return data.keys().hasAll(['bountyId', 'ownerUid', 'memberId', 'claimantName', 'targetName', 'amount', 'mode', 'clipUrl', 'notes', 'status', 'createdAt', 'updatedAt', 'reviewedAt', 'reviewerUid', 'reason'])
        && data.keys().hasOnly(['bountyId', 'ownerUid', 'memberId', 'claimantName', 'targetName', 'amount', 'mode', 'clipUrl', 'notes', 'status', 'createdAt', 'updatedAt', 'reviewedAt', 'reviewerUid', 'reason'])
        && data.bountyId is string && data.bountyId.matches('^[A-Za-z0-9_-]{1,80}$')
        && data.ownerUid is string && data.ownerUid.size() > 0 && data.ownerUid.size() <= 128
        && data.memberId is string && data.memberId.size() <= 100
        && data.claimantName is string && data.claimantName.size() > 0 && data.claimantName.size() <= 80
        && data.targetName is string && data.targetName.size() > 0 && data.targetName.size() <= 80
        && data.amount is int && data.amount >= 5 && data.amount <= 20
        && data.mode in ['Any mode', 'Battle Royale', 'Zero Build', 'Reload']
        && data.clipUrl is string && data.clipUrl.size() <= 2000
        && data.clipUrl.matches('^https://(www[.])?(youtube[.]com|youtu[.]be|streamable[.]com|clips[.]twitch[.]tv)/[A-Za-z0-9_/?&=.%#~+-]+$')
        && data.notes is string && data.notes.size() <= 600
        && data.status in ['pending', 'approved', 'denied']
        && data.createdAt is timestamp && data.updatedAt == request.time
        && data.reviewerUid is string && data.reason is string && data.reason.size() <= 600;
    }

    function validSubmission(claimId) {
      let data = request.resource.data;
      let bounty = get(/databases/$(database)/documents/bounties/$(data.bountyId)).data;
      return activeBountyMember(data)
        && data.ownerUid == request.auth.uid
        && claimId == data.bountyId + '_' + request.auth.uid
        && bounty.status == 'open' && bounty.winningClaimId == ''
        && (bounty.get('expiresAt', null) == null || bounty.expiresAt > request.time)
        && data.targetName == bounty.targetName && data.amount == bounty.amount && data.mode == bounty.mode
        && data.status == 'pending' && data.reviewedAt == null && data.reviewerUid == '' && data.reason == '';
    }

    function validClaimReview(claimId) {
      let next = request.resource.data;
      return isAdmin() && resource.data.status == 'pending'
        && next.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewerUid', 'reason', 'updatedAt'])
        && next.reviewerUid == request.auth.uid && next.reviewedAt == request.time
        && ((next.status == 'denied' && next.reason.size() > 0)
          || (next.status == 'approved'
            && get(/databases/$(database)/documents/bounties/$(next.bountyId)).data.status == 'open'
            && get(/databases/$(database)/documents/bounties/$(next.bountyId)).data.winningClaimId == ''
            && getAfter(/databases/$(database)/documents/bounties/$(next.bountyId)).data.status == 'claimed'
            && getAfter(/databases/$(database)/documents/bounties/$(next.bountyId)).data.winningClaimId == claimId));
    }

    match /bountyClaims/{claimId} {
      // List queries must be scoped to the caller's ownerUid unless they are an admin.
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if validClaim(request.resource.data) && validSubmission(claimId)
        && request.resource.data.createdAt == request.time;
      allow update: if validClaim(request.resource.data)
        && (validClaimReview(claimId)
          || (resource.data.ownerUid == request.auth.uid && resource.data.status == 'denied'
            && request.resource.data.bountyId == resource.data.bountyId
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.createdAt == resource.data.createdAt
            && validSubmission(claimId)));
      allow delete: if false;
    }

    match /admins/{userId} {
      allow get: if signedIn() && userId == request.auth.uid;
      allow list: if isAdmin();
      allow create, update: if (isAdmin() || (signedIn() && userId == request.auth.uid))
        && request.resource.data.keys().hasOnly(['memberId', 'enabled'])
        && request.resource.data.enabled == true && request.resource.data.memberId is string
        && getAfter(/databases/$(database)/documents/memberAccess/$(request.resource.data.memberId)).data.ownerUid == userId
        && getAfter(/databases/$(database)/documents/memberAccess/$(request.resource.data.memberId)).data.role == 'admin'
        && getAfter(/databases/$(database)/documents/memberAccess/$(request.resource.data.memberId)).data.status == 'active';
      allow delete: if isAdmin() && userId != request.auth.uid;
    }

    match /adminActivity/{eventId} {
      allow read: if isAdmin();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['actorUid', 'actorEmail', 'action', 'targetType', 'targetId', 'detail', 'createdAt'])
        && request.resource.data.actorUid == request.auth.uid && request.resource.data.actorEmail == request.auth.token.get('email', '')
        && request.resource.data.createdAt == request.time
        && request.resource.data.action is string && request.resource.data.action.size() <= 80
        && request.resource.data.targetType is string && request.resource.data.targetType.size() <= 80
        && request.resource.data.targetId is string && request.resource.data.targetId.size() <= 200
        && request.resource.data.detail is string && request.resource.data.detail.size() <= 300
        && (isAdmin() || (request.resource.data.action == 'account-linked' && request.resource.data.targetType == 'memberAccess'
          && getAfter(/databases/$(database)/documents/memberAccess/$(request.resource.data.targetId)).data.ownerUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/memberAccess/$(request.resource.data.targetId)).data.claimedAt == request.time));
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['ownerUid', 'type', 'targetId', 'message', 'read', 'createdAt'])
        && request.resource.data.ownerUid is string && request.resource.data.targetId is string
        && request.resource.data.type in ['account-linked', 'claim-approved', 'claim-denied', 'reward-delivered', 'dispute-resolved']
        && request.resource.data.message is string && request.resource.data.message.size() <= 600
        && request.resource.data.read == false && request.resource.data.createdAt == request.time
        && (isAdmin() || (request.resource.data.type == 'account-linked' && request.resource.data.ownerUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/memberAccess/$(request.resource.data.targetId)).data.ownerUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/memberAccess/$(request.resource.data.targetId)).data.claimedAt == request.time));
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) && request.resource.data.read is bool;
      allow delete: if false;
    }

    match /bountyRewards/{claimId} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['ownerUid', 'claimId', 'status', 'note', 'updatedAt', 'updatedBy'])
        && request.resource.data.claimId == claimId && request.resource.data.ownerUid == get(/databases/$(database)/documents/bountyClaims/$(claimId)).data.ownerUid
        && get(/databases/$(database)/documents/bountyClaims/$(claimId)).data.status == 'approved'
        && request.resource.data.status in ['pending', 'delivered']
        && request.resource.data.note is string && request.resource.data.note.size() <= 300
        && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    function validContent(data) {
      return data.keys().hasAll(['title', 'label', 'body', 'status', 'order', 'link', 'linkLabel', 'revision', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.label is string && data.label.size() <= 80
        && data.body is string && data.body.size() > 0 && data.body.size() <= 10000
        && data.status in ['draft', 'published', 'archived']
        && data.order is int && data.order >= -10000 && data.order <= 10000
        && data.link is string && data.link.size() <= 1000
        && (data.link == '' || data.link.matches('^https://[^ ]+$')
          || data.link.matches('^([A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+[.]html(#[A-Za-z0-9_-]+)?$')
          || data.link.matches('^events/[A-Za-z0-9_-]+/$'))
        && data.linkLabel is string && data.linkLabel.size() <= 80
        && data.revision is int && data.revision > 0
        && data.createdAt is timestamp && data.updatedAt == request.time;
    }
    function validEvent(data) {
      return validContent(data)
        && data.keys().hasOnly(['title', 'label', 'body', 'status', 'order', 'link', 'linkLabel', 'revision', 'createdAt', 'updatedAt', 'startsAt', 'endsAt', 'eventState', 'result', 'participants', 'mode', 'reward'])
        && (data.startsAt == null || data.startsAt is timestamp) && (data.endsAt == null || data.endsAt is timestamp)
        && (data.startsAt == null || data.endsAt == null || data.endsAt >= data.startsAt)
        && data.eventState in ['upcoming', 'ended', 'cancelled']
        && data.result is string && data.result.size() <= 200
        && data.participants is string && data.participants.size() <= 4000
        && data.mode is string && data.mode.size() <= 120 && data.reward is string && data.reward.size() <= 120;
    }
    function validAnnouncement(data) {
      return validContent(data)
        && data.keys().hasOnly(['title', 'label', 'body', 'status', 'order', 'link', 'linkLabel', 'revision', 'createdAt', 'updatedAt', 'publishedAt', 'countdownAt', 'featured'])
        && (data.publishedAt == null || data.publishedAt is timestamp)
        && (data.countdownAt == null || data.countdownAt is timestamp) && data.featured is bool;
    }
    function validContentRevision() {
      return request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.revision == resource.data.revision + 1;
    }
    match /siteEvents/{eventId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create: if isAdmin() && validEvent(request.resource.data) && request.resource.data.revision == 1 && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && validEvent(request.resource.data) && validContentRevision();
      allow delete: if false;
    }
    match /siteAnnouncements/{announcementId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create: if isAdmin() && validAnnouncement(request.resource.data) && request.resource.data.revision == 1 && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && validAnnouncement(request.resource.data) && validContentRevision();
      allow delete: if false;
    }
    match /siteContentState/{stateId} {
      allow read: if true;
      allow create, update: if stateId == 'settings' && isAdmin()
        && request.resource.data.keys().hasOnly(['eventsManaged', 'announcementsManaged', 'updatedAt'])
        && request.resource.data.eventsManaged is bool && request.resource.data.announcementsManaged is bool
        && request.resource.data.updatedAt == request.time
        && (!exists(/databases/$(database)/documents/siteContentState/$(stateId))
          || ((!resource.data.eventsManaged || request.resource.data.eventsManaged)
            && (!resource.data.announcementsManaged || request.resource.data.announcementsManaged)));
      allow delete: if false;
    }

    match /claimDisputes/{claimId} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['ownerUid', 'claimId', 'message', 'status', 'resolution', 'createdAt', 'updatedAt'])
        && request.resource.data.ownerUid == request.auth.uid && request.resource.data.claimId == claimId
        && get(/databases/$(database)/documents/bountyClaims/$(claimId)).data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/bountyClaims/$(claimId)).data.status == 'denied'
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 600
        && request.resource.data.status == 'open' && request.resource.data.resolution == ''
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolution', 'updatedAt'])
        && request.resource.data.status == 'resolved' && request.resource.data.resolution is string
        && request.resource.data.resolution.size() > 0 && request.resource.data.resolution.size() <= 600 && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
  }
}
